# KnowPilot 环境变量模板
#
# ⚠️ 本仓库有**两份** .env，读的人不同（2026-09-16 反复踩过）：
#     backend/.env —— 本地 uvicorn / PyCharm 里的 Celery worker 读（config.py 的 env_file）
#     根 .env      —— docker-compose 读（做变量插值 + env_file 注进容器）
#   本地开发只动 backend/.env；生产部署动**服务器上的**根 .env。
#
# ⚠️ 变量名必须与 backend/app/core/config.py 的字段一一对应。写错名字**不会报错** ——
#    SettingsConfigDict(extra="ignore") 会静默忽略（2026-09-23 实踩：DEEPSEEK_SYNTH_MODEL
#    与字段 deepseek_review_model 对不上，配了等于没配）。顺序也要对：
#    **先有代码字段、后有 .env 变量**，反过来同样是被静默忽略。
#
# ⚠️ 本地 Docker 直连 pypi.org 时大响应会被截断导致 build 失败 ⇒ 本机开发才需要国内源；
#    云端不填即可，Dockerfile 默认走官方源。

# ---------------------------------------------------------------- 数据库
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------- LLM（DeepSeek，模型分级）
# 模型名走 langchain `init_chat_model` 的 `provider:model` 格式。
# 写成裸的 `deepseek-chat` 也能跑起来，但那已经是**另一个模型**了 —— 会与本地不一致。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 写作：planner + synthesizer
DEEPSEEK_PLANNER_MODEL=deepseek:deepseek-v4-flash
# 评审：critic（分档的理由是「评审要更强的模型」，省成本只是顺带）
DEEPSEEK_REVIEW_MODEL=deepseek:deepseek-v4-pro

# ---------------------------------------------------------------- 嵌入（DashScope，1024 维）
# ⚠️ DASHSCOPE_API_KEY 必须填：embedder 用的是 DashScopeEmbeddings，
#    缺这个 key（且环境变量也没有）时会在 get_embedder() 里**直接抛 ValueError**，
#    不是静默降级 ⇒ 上传文档 / 检索全挂（2026-09-23 实测）。
# 维度固定 1024，与 Milvus collection schema 的 dim 绑定；改模型要连带重建索引。
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding

# ---------------------------------------------------------------- Milvus
# 本地开发：指向 docker-compose.yml 起的本地 Milvus，token 留空即可
#   （本地 Milvus 未开鉴权，实测填个错 token 也会被忽略）
# 生产部署：指向 Zilliz Cloud 托管实例，URI / TOKEN 都必须填
#   （docker-compose.prod.yml 里用了 :? 语法，不填会直接拒绝启动）
#   MILVUS_URI=https://in01-xxxx.serverless.ali-cn-hangzhou.cloud.zilliz.com
#   MILVUS_TOKEN=<控制台 API Keys 页给的 token，或集群凭证 "user:password">
#   ⚠️ Zilliz Cloud 只支持 AUTOINDEX 索引，代码已按此设置（原先的 IVF_FLAT 上不去）。
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=knowpilot_chunks
MILVUS_TOKEN=

# ---------------------------------------------------------------- JWT
# 生产务必换掉 change-me；换掉后已签发的 token 全部失效（需重新登录）。
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------- Docker build（可选）
# compose 的 build.args 会读它 —— 本机 build 时填国内源，云端不填。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---------------------------------------------------------------- 已声明但代码未用（占位，留空不影响功能）
# 2026-09-23 静态核查（扫 backend/app/）：
#   OPENAI_*      —— config.py:48/49 有字段，但零调用；embedder.py 硬编码 DashScopeEmbeddings，
#                    要真切 OpenAI 得先改那个文件。
#   BOCHA_API_KEY —— config.py:52 有字段，同样零调用（联网搜索尚未接入）。
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BOCHA_API_KEY=
