# 数据库
POSTGRES_PASSWORD=change-me
MINIO_USER=knowpilot
MINIO_PASSWORD=change-me

# LLM（DeepSeek）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PLANNER_MODEL=deepseek-chat
DEEPSEEK_SYNTH_MODEL=deepseek-reasoner

# 嵌入（DashScope 云端，1024 维；可选 OpenAI 切换）
# 注：这里原先写的是本地 bge-m3，已过时 —— 实际跑的是 DashScope text-embedding，
#     且维度固定 1024（与 Milvus collection schema 的 dim 绑定，改它要连带重建索引）
EMBEDDING_MODEL=qwen3.7-text-embedding
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 联网搜索（博查）
BOCHA_API_KEY=

# Milvus
#
# 本地开发：指向 docker-compose.yml 起的本地 Milvus，token 留空即可
#   （本地 Milvus 未开鉴权，实测填个错 token 也会被忽略）
# 生产部署：指向 Zilliz Cloud 托管实例，两个都必须填
#   （docker-compose.prod.yml 里用了 :? 语法，不填会直接拒绝启动）
#   MILVUS_URI=https://in01-xxxx.serverless.ali-cn-hangzhou.cloud.zilliz.com
#   MILVUS_TOKEN=<控制台给的 "user:password" 或 API Key>
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=knowpilot_chunks
MILVUS_TOKEN=

# JWT
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080

# 报告导出（OSS/MinIO 可选）
MINIO_ENDPOINT=localhost:9000

# Docker build（可选）：compose 的 build.args 会读这个变量。
# 本机 Docker 直连 pypi.org 时大响应会被截断导致 build 失败，填国内镜像源；
# 云端部署不填即可，Dockerfile 默认走官方源。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
