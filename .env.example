# 数据库
POSTGRES_PASSWORD=change-me
MINIO_USER=knowpilot
MINIO_PASSWORD=change-me

# LLM（DeepSeek）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PLANNER_MODEL=deepseek-chat
DEEPSEEK_SYNTH_MODEL=deepseek-reasoner

# 嵌入（本地 bge-m3，走 sentence-transformers；可选 OpenAI 切换）
EMBEDDING_MODEL=BAAI/bge-m3
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 联网搜索（博查）
BOCHA_API_KEY=

# Milvus
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=knowpilot_chunks

# JWT
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080

# 报告导出（OSS/MinIO 可选）
MINIO_ENDPOINT=localhost:9000

# Docker build（可选）：compose 的 build.args 会读这个变量。
# 本机 Docker 直连 pypi.org 时大响应会被截断导致 build 失败，填国内镜像源；
# 云端部署不填即可，Dockerfile 默认走官方源。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
