# 生产构建（vite build）加载的变量。
#
# 为什么必须单独有这个文件：Vite 只在对应模式下加载对应的 env 文件 ——
#   `vite`（dev）      读 .env.development
#   `vite build`（prod）读 .env.production
# 没有它的话，logo.vue 的 VITE_APP_NAME 和 LoginView.vue 的 VITE_APP_VERSION
# 在打包产物里就是 undefined，页面上会直接显示空白 / "undefined"。
#
# API 用**相对路径**：生产由 nginx 把 /api/* 反代到 backend，
# 镜像搬到任何 IP 或域名都不用重新构建。

VITE_API_BASE = '/api/v1'
VITE_APP_VERSION = 'v0.1.0'
VITE_APP_NAME = '知研 KnowPilot 知识库'
