# 前端生产镜像（多阶段构建）
#
# 与 dev 版的区别：dev 跑的 `vite` 是**开发服务器**（带 HMR、不做压缩、单线程，
# 本来就不该对外）。这里阶段 1 用 `vite build` 产出静态文件，阶段 2 交给 nginx
# 托管，并由 nginx 把 /api/* 反代到 backend:8000。
#
# 构建与运行都由 docker-compose.prod.yml 驱动，一般不用手敲。
# 手工构建（在项目根目录执行）：
#   docker build -f frontend/Dockerfile.prod -t knowpilot-frontend ./frontend
# 国内网络构建慢的话，加 --build-arg NPM_REGISTRY=https://registry.npmmirror.com

# ---------------------------------------------------------------- 阶段 1：构建
FROM node:22-alpine AS builder
WORKDIR /app

ARG NPM_REGISTRY=https://registry.npmjs.org
# corepack 下载 pnpm 走的也是 npm 源，单独有环境变量
ENV COREPACK_NPM_REGISTRY=${NPM_REGISTRY}

# 项目在 package.json 里声明了 packageManager: pnpm@10.16.1，
# 用 corepack 激活同一个版本，避免"本机 pnpm 版本不同 → lockfile 对不上"
RUN corepack enable && corepack prepare pnpm@10.16.1 --activate \
    && pnpm config set registry ${NPM_REGISTRY}

# 先只拷依赖清单：源码改动不会让这一层缓存失效，重建能省掉整个 install
COPY package.json pnpm-lock.yaml ./
# --frozen-lockfile：lockfile 与 package.json 不一致时直接失败，而不是悄悄改依赖
RUN pnpm install --frozen-lockfile

# .dockerignore 已排除 node_modules/ 和 dist/，宿主机的依赖不会覆盖上面装的
COPY . .

# package.json 的 build = "vue-tsc -b && vite build"，类型不过就不出产物
RUN pnpm build

# ---------------------------------------------------------------- 阶段 2：运行
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
