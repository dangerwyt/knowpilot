# 运行时数据（用户上传的原文件，属本地状态，不进版本控制）
backend/storage/

# 前端构建产物（`vue-tsc -b` 生成，源文件是 vite.config.ts）
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# 验收工具目录：只收「被入库文件点名引用」的可复用工具，
# 一次性探针/诊断脚本（t78_epoch_diag.py 等）和运行时产物（t78probe/）不入库。
#
# 两条写法注意（都实测踩过）：
#   ① 必须用 playground/* 而不是 playground/。
#      目录后带尾斜杠 = 整个目录被排除，下面的 ! 负向规则**穿不透**；
#      写成 /* 排除的是「目录里的内容」，负向规则才能把指定文件捞回来。
#   ② .gitignore **不支持行尾注释**。`# 说明` 只有写在行首才是注释，
#      跟在规则后面会被当成规则内容的一部分，规则静默失效（无任何报错）。
#      所以下面的说明一律单独占一行。
backend/playground/*
# 模型 vs 现库结构体检（migrations/README.md 的门禁步骤）
!backend/playground/schema_drift.py
# PG vs Milvus 数据漂移巡检
!backend/playground/drift_check.py
# 孤儿数据清理（Milvus 块 / storage 目录）
!backend/playground/cleanup_orphans.py
# Milvus 集合重建（同代次重复块收不掉时的兜底手段）
!backend/playground/rebuild_vectors.py
# 存量块代次刷新
!backend/playground/reload_vectors.py
# T82 验收：走 HTTP 让后端进程执行删除（沙箱内的 rmdir 语义不可信）
!backend/playground/t82_real_env_test.py
# T82 验收：沙箱感知版（命中改写时把相关判据标 SKIP 而非 FAIL）
!backend/playground/t82_storage_cleanup_test.py
# T86 验收：probe 相关性阈值 + 无资料章节数（进程内直调，不发任务）
!backend/playground/t86_probe_threshold_test.py
# T86 验收：端到端发真任务，带 --reuse 可复用已有任务只重跑判据
!backend/playground/t86_e2e_task_test.py
# T87 验收：retriever 复用 probe「无资料」结论（静态比对 + 进程内直调）
!backend/playground/t87_retriever_material_test.py
# 仓库体检：提交前跑一遍（.gitignore 正反向 / 白名单 / 死引用 / 卫生）
!backend/playground/t83_git_repo_check.py
# LangGraph 静默丢弃未声明 state 键的最小复现（踩坑 #91 引用）
!backend/playground/t87_langgraph_key_probe.py
# T88 验收：critic 分项分数（静态 + 直调质检 + 降级分支）
!backend/playground/t88_critic_dimensions_test.py
# T88 前端实测：质检弹窗四行分项与 DB 逐项比对
!backend/playground/t88_frontend_dimensions_test.js
# T89a 验收：has_material 落库 + 报告页警告条
!backend/playground/t89a_has_material_test.py
# T89a 前端实测：警告条三组对照（false 显示 / true 不显示 / 无键不显示）
!backend/playground/t89a_frontend_has_material_test.js
# T89b 验收：发起前预检接口（静态 + HTTP 三态 + 进程内降级路径）
!backend/playground/t89b_precheck_test.py
# T89b 前端实测：预检确认框四场景 + 真任务验 probe 行变黄（含对照组）
!backend/playground/t89b_frontend_precheck_test.js
# T98 验收：事件流第一条提示不冒用节点名（含判据自检，踩坑 #98）
!backend/playground/t98_event_order_test.py
# Celery worker 是否比代码新的核对工具（2026-09-15 从 .workbuddy/tmp 搬入，
# 旧判据会被沙箱辅助进程骗出假 PASS）
!backend/playground/check_worker_start.py
# T99 验收：三处修复（前端依赖声明 / main.ts 单实例 / citation.kb_id 归属）
!backend/playground/t99_fixes_test.py
# T99 前端实测：图标是否注册在"真正被挂载"的那个 app 实例上
!backend/playground/t99_frontend_icon_test.js
# T100 验收：compose 的 worker 必须 --pool=solo（配置层 + 自检 + 容器层实测）
!backend/playground/t100_compose_worker_test.py

# 迁移执行记录（记录的是「这个库跑过什么」，属本地状态）
backend/migrations/APPLIED.log
