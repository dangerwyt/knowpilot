# 后端配置。复制成 backend/.env 后按需修改：
#   cp backend/.env.example backend/.env
# 下面列的是"必须自己填"的项；没列的（Redis / Milvus / JWT 等）
# 在 app/core/config.py 里有本地默认值，本机起容器不用动。

# 数据库（密码要与根目录 .env 里的 POSTGRES_PASSWORD 一致）
DATABASE_URL=postgresql+asyncpg://knowpilot:change-me@localhost:5432/knowpilot

# ---- 大模型：DeepSeek（写作 / 评审分级，都不填也能跑，会走降级路径）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PLANNER_MODEL=deepseek:deepseek-v4-flash
DEEPSEEK_REVIEW_MODEL=deepseek:deepseek-v4-pro

# ---- 认证 ----
# 是否开放自助注册（POST /api/v1/auth/register）。
#   线上部署建议 false：否则一旦 8080 公网可达，陌生人可注册并消耗 LLM 额度。
#   本地保持 true：playground 的前端测试脚本（t88/t89a/t89b）靠它自建测试账号。
ALLOW_REGISTRATION=true

# ---- 向量嵌入：阿里云百炼 DashScope（不填则无法建索引/检索）----
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSION=1024
